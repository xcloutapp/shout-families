rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMember(gid) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/groups/$(gid)).data.memberIds;
    }

    // Each person's own profile and saved usuals.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /groups/{gid} {
      // Group ids are random and only shared through invite links,
      // so a signed-in person can open one they've been given.
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid];

      // Members can update the group (names, under-18 settings).
      // Anyone else may only add themselves (joining via invite).
      allow update: if signedIn() && (
        request.auth.uid in resource.data.memberIds
        || (
          request.resource.data.memberIds == resource.data.memberIds.concat([request.auth.uid])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'members'])
        )
      );
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      // Chats: members of the chat can read and write. "Everyone" chats are open to every group
      // member, so a new member can add themselves after joining.
      match /chats/{chatId} {
        allow get: if isMember(gid) && (resource == null || request.auth.uid in resource.data.memberIds || resource.data.everyone == true);
        allow list: if isMember(gid) && (request.auth.uid in resource.data.memberIds || resource.data.everyone == true);
        allow create: if isMember(gid) && request.auth.uid in request.resource.data.memberIds;
        allow update: if isMember(gid) && (
          request.auth.uid in resource.data.memberIds
          || (resource.data.everyone == true
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds']))
        );
        allow delete: if false;

        match /messages/{messageId} {
          function inChat() {
            return isMember(gid)
              && request.auth.uid in get(/databases/$(database)/documents/groups/$(gid)/chats/$(chatId)).data.memberIds;
          }
          allow read, create, update: if inChat();
          // Only the person who sent a message can delete it.
          allow delete: if inChat() && resource.data.authorId == request.auth.uid;
        }
      }
      match /photos/{photoId} {
        allow read, write: if isMember(gid);
      }
      match /cards/{cardId} {
        allow read, write: if isMember(gid);
      }
      match /ledger/{entryId} {
        allow read, write: if isMember(gid);
      }
    }

    // A shared run link. The token in the link is random and long, so knowing it is the permission.
    // Guests (no account) can read it and add an order while it's open.
    match /shares/{token} {
      allow get: if true;
      allow list: if false;
      allow create, update: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/groups/$(request.resource.data.gid)).data.memberIds;
      allow delete: if false;

      match /guestOrders/{orderId} {
        allow create: if get(/databases/$(database)/documents/shares/$(token)).data.open == true
          && request.resource.data.keys().hasOnly(['name', 'text', 'at'])
          && request.resource.data.name is string && request.resource.data.name.size() <= 40
          && request.resource.data.text is string && request.resource.data.text.size() <= 300;
        allow read, delete: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(get(/databases/$(database)/documents/shares/$(token)).data.gid)).data.memberIds;
      }
    }
  }
}
